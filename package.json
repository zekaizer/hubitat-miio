{
  "name": "homebridge-miio-local",
  "displayName": "Homebridge Miio Local",
  "version": "0.2.0",
  "description": "Homebridge plugin for Xiaomi miio devices over the LAN, without the Xiaomi cloud",
  "license": "Apache-2.0",
  "author": "Luke Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zekaizer/homebridge-miio-local.git"
  },
  "engines": {
    "node": "^20.9.0 || ^22.0.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "fmt": "biome check --write .",
    "fmt:check": "biome check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "xiaomi",
    "miio",
    "miot",
    "fan",
    "humidifier"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^20.11.0",
    "hap-nodejs": "^0.12.0",
    "homebridge": "^1.8.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
